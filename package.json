{
  "name": "bookloft",
  "private": true,
  "version": "0.10.0",
  "description": "Tu biblioteca personal en el teléfono: estantes, sagas, bóveda de EPUB y respaldos, sin cuentas ni servidores.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/KbzonZito/library_app.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:live": "scripts/android-live.sh",
    "emulators": "scripts/setup-emulators.sh",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "check": "tsc --noEmit && npm run lint && npm run format:check && npm run knip && npm test",
    "apk": "scripts/build-apk.sh",
    "release": "scripts/release.sh",
    "knip": "knip"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor-mlkit/text-recognition": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/file-viewer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-share-target": "^8.0.68",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^6.3.0",
    "knip": "^6.47.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
