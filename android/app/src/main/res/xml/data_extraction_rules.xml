<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o posterior: mismas reglas que backup_rules.xml, para la nube y para pasar a otro teléfono -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="file" path="vault/" />
        <exclude domain="file" path="inbox/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
